<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="morphonav">

  <!-- Single-source URDF for MorphoNav. Toggle simulation Gazebo plugins via:
         xacro morphonav.urdf.xacro use_sim:=true   (Gazebo)
         xacro morphonav.urdf.xacro use_sim:=false  (real hardware, default)

       Drivetrain: 4-wheel differential drive. RWD drives rear pair; AWD drives
       both pairs (skid-steer). Select with:
         xacro morphonav.urdf.xacro drive_mode:=rwd   (default)
         xacro morphonav.urdf.xacro drive_mode:=awd                                -->
  <xacro:arg name="use_sim"    default="false"/>
  <xacro:arg name="drive_mode" default="rwd"/>
  <xacro:property name="use_sim"    value="$(arg use_sim)"/>
  <xacro:property name="drive_mode" value="$(arg drive_mode)"/>

  <!-- Robot dimensions -->
  <xacro:property name="chassis_l"    value="0.40"/>
  <xacro:property name="chassis_w"    value="0.28"/>
  <xacro:property name="chassis_h"    value="0.08"/>
  <xacro:property name="chassis_mass" value="4.0"/>

  <xacro:property name="wheel_r"    value="0.06"/>
  <xacro:property name="wheel_w"    value="0.04"/>
  <xacro:property name="wheel_mass" value="0.3"/>

  <xacro:property name="wheelbase"   value="0.28"/>
  <xacro:property name="track_width" value="0.30"/>

  <xacro:property name="chassis_z" value="${2*wheel_r + chassis_h/2}"/>

  <!-- Sensor mount macros -->
  <xacro:include filename="$(find morphonav_description)/urdf/imu.xacro"/>
  <xacro:include filename="$(find morphonav_description)/urdf/gps.xacro"/>

  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name="rubber"><color rgba="0.12 0.12 0.12 1.0"/></material>
      </visual>
      <visual>
        <geometry><cylinder radius="${wheel_r*0.50}" length="${wheel_w*0.35}"/></geometry>
        <origin xyz="0 ${wheel_w*0.33} 0" rpy="${pi/2} 0 0"/>
        <material name="hub_silver"><color rgba="0.78 0.78 0.78 1.0"/></material>
      </visual>
      <visual>
        <geometry><cylinder radius="${wheel_r*0.50}" length="${wheel_w*0.35}"/></geometry>
        <origin xyz="0 ${-wheel_w*0.33} 0" rpy="${pi/2} 0 0"/>
        <material name="hub_silver2"><color rgba="0.78 0.78 0.78 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass*(3*wheel_r*wheel_r + wheel_w*wheel_w)/12}"
          iyy="${wheel_mass*wheel_r*wheel_r/2}"
          izz="${wheel_mass*(3*wheel_r*wheel_r + wheel_w*wheel_w)/12}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Base frames -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry>
      <material name="chassis_body"><color rgba="0.17 0.17 0.20 1.0"/></material>
    </visual>
    <visual>
      <geometry><box size="${chassis_l*0.68} ${chassis_w*0.82} 0.046"/></geometry>
      <origin xyz="-0.02 0 ${chassis_h/2 + 0.023}" rpy="0 0 0"/>
      <material name="accent"><color rgba="1.0 0.44 0.0 1.0"/></material>
    </visual>
    <visual>
      <geometry><box size="0.024 ${chassis_w + 0.022} ${chassis_h*0.80}"/></geometry>
      <origin xyz="${chassis_l/2 + 0.012} 0 0" rpy="0 0 0"/>
      <material name="bumper"><color rgba="0.52 0.52 0.52 1.0"/></material>
    </visual>
    <visual>
      <geometry><box size="0.024 ${chassis_w + 0.022} ${chassis_h*0.80}"/></geometry>
      <origin xyz="${-chassis_l/2 - 0.012} 0 0" rpy="0 0 0"/>
      <material name="bumper2"><color rgba="0.52 0.52 0.52 1.0"/></material>
    </visual>
    <visual>
      <geometry><cylinder radius="0.022" length="0.06"/></geometry>
      <origin xyz="0.05 0 ${chassis_h/2 + 0.03}" rpy="0 0 0"/>
      <material name="pedestal"><color rgba="0.20 0.20 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${chassis_l + 0.05} ${chassis_w + 0.022} ${chassis_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${chassis_mass*(chassis_w*chassis_w + chassis_h*chassis_h)/12}"
        iyy="${chassis_mass*(chassis_l*chassis_l + chassis_h*chassis_h)/12}"
        izz="${chassis_mass*(chassis_l*chassis_l + chassis_w*chassis_w)/12}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- All four wheels are continuous joints parented directly to base_link.
       Front wheels no longer steer (diff-drive). -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="front_left_wheel"/>
    <origin xyz="${wheelbase/2} ${track_width/2} ${-chassis_h/2 - wheel_r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <xacro:wheel_link name="front_left_wheel"/>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="front_right_wheel"/>
    <origin xyz="${wheelbase/2} ${-track_width/2} ${-chassis_h/2 - wheel_r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <xacro:wheel_link name="front_right_wheel"/>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="rear_left_wheel"/>
    <origin xyz="${-wheelbase/2} ${track_width/2} ${-chassis_h/2 - wheel_r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <xacro:wheel_link name="rear_left_wheel"/>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="rear_right_wheel"/>
    <origin xyz="${-wheelbase/2} ${-track_width/2} ${-chassis_h/2 - wheel_r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <xacro:wheel_link name="rear_right_wheel"/>

  <!-- Lidar -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_frame"/>
    <origin xyz="0.05 0 ${chassis_h/2 + 0.046 + 0.06 + 0.028}" rpy="0 0 0"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="0.038" length="0.055"/></geometry>
      <material name="lidar_body"><color rgba="0.04 0.04 0.04 1.0"/></material>
    </visual>
    <visual>
      <geometry><cylinder radius="0.040" length="0.010"/></geometry>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <material name="lidar_ring"><color rgba="0.15 0.55 1.0 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.038" length="0.055"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- IMU + GPS mounts -->
  <xacro:morphonav_imu parent="base_link" use_sim="${use_sim}"/>
  <xacro:morphonav_gps parent="base_link" use_sim="${use_sim}"/>

  <!-- ═══════════════════════════════════════════════
       GAZEBO — only emitted when use_sim:=true
       ═══════════════════════════════════════════════ -->
  <xacro:if value="${use_sim}">

    <!-- Wheel contact tuning (TurtleBot-style proven values). Low mu2 lets
         the wheels slide laterally during skid-steer rotation; minDepth +
         kp prevent the wheels from sinking into the ground. -->
    <xacro:macro name="wheel_contact" params="name">
      <gazebo reference="${name}">
        <material>Gazebo/FlatBlack</material>
        <mu1>1.0</mu1>
        <mu2>0.05</mu2>
        <kp>10000000.0</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.5</maxVel>
        <fdir1>1 0 0</fdir1>
      </gazebo>
    </xacro:macro>
    <xacro:wheel_contact name="rear_left_wheel"/>
    <xacro:wheel_contact name="rear_right_wheel"/>
    <xacro:wheel_contact name="front_left_wheel"/>
    <xacro:wheel_contact name="front_right_wheel"/>
    <gazebo reference="base_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- Lidar -->
    <gazebo reference="laser_frame">
      <sensor type="ray" name="rplidar_sim">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.20</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=/scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>laser_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Differential-drive plugin. RWD drives only the rear pair; AWD lists
         all 4 wheels via num_wheel_pairs=2 so the plugin treats them as one
         skid-steer drivetrain (proper Twist response, no plugin-vs-plugin
         conflict). publish_odom_tf publishes odom -> base_footprint. -->
    <xacro:if value="${drive_mode == 'rwd'}">
      <gazebo>
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
          <update_rate>50.0</update_rate>
          <num_wheel_pairs>1</num_wheel_pairs>
          <left_joint>rear_left_wheel_joint</left_joint>
          <right_joint>rear_right_wheel_joint</right_joint>
          <wheel_separation>${track_width}</wheel_separation>
          <wheel_diameter>${wheel_r*2}</wheel_diameter>
          <max_wheel_torque>5.0</max_wheel_torque>
          <max_wheel_acceleration>2.0</max_wheel_acceleration>
          <command_topic>cmd_vel</command_topic>
          <odometry_topic>odom</odometry_topic>
          <odometry_frame>odom</odometry_frame>
          <robot_base_frame>base_footprint</robot_base_frame>
          <publish_odom>true</publish_odom>
          <publish_odom_tf>true</publish_odom_tf>
          <publish_wheel_tf>false</publish_wheel_tf>
          <odometry_source>1</odometry_source>
        </plugin>
      </gazebo>
    </xacro:if>

    <xacro:if value="${drive_mode == 'awd'}">
      <gazebo>
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
          <update_rate>50.0</update_rate>
          <num_wheel_pairs>2</num_wheel_pairs>
          <left_joint>rear_left_wheel_joint</left_joint>
          <left_joint>front_left_wheel_joint</left_joint>
          <right_joint>rear_right_wheel_joint</right_joint>
          <right_joint>front_right_wheel_joint</right_joint>
          <wheel_separation>${track_width}</wheel_separation>
          <wheel_separation>${track_width}</wheel_separation>
          <wheel_diameter>${wheel_r*2}</wheel_diameter>
          <wheel_diameter>${wheel_r*2}</wheel_diameter>
          <max_wheel_torque>5.0</max_wheel_torque>
          <max_wheel_acceleration>2.0</max_wheel_acceleration>
          <command_topic>cmd_vel</command_topic>
          <odometry_topic>odom</odometry_topic>
          <odometry_frame>odom</odometry_frame>
          <robot_base_frame>base_footprint</robot_base_frame>
          <publish_odom>true</publish_odom>
          <publish_odom_tf>true</publish_odom_tf>
          <publish_wheel_tf>false</publish_wheel_tf>
          <odometry_source>1</odometry_source>
        </plugin>
      </gazebo>
    </xacro:if>

    <!-- Joint state publisher so RViz/RSP gets all four wheel joints -->
    <gazebo>
      <plugin name="joint_state_publisher"
              filename="libgazebo_ros_joint_state_publisher.so">
        <update_rate>30</update_rate>
        <joint_name>rear_left_wheel_joint</joint_name>
        <joint_name>rear_right_wheel_joint</joint_name>
        <joint_name>front_left_wheel_joint</joint_name>
        <joint_name>front_right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

  </xacro:if>

</robot>
