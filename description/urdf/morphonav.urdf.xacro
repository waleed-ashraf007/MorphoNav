<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="morphonav">

  <!-- Single-source URDF for MorphoNav. Toggle simulation Gazebo plugins via:
         xacro morphonav.urdf.xacro use_sim:=true   (Gazebo)
         xacro morphonav.urdf.xacro use_sim:=false  (real hardware, default) -->
  <xacro:arg name="use_sim" default="false"/>
  <xacro:property name="use_sim" value="$(arg use_sim)"/>

  <!-- Robot dimensions -->
  <xacro:property name="chassis_l"    value="0.40"/>
  <xacro:property name="chassis_w"    value="0.28"/>
  <xacro:property name="chassis_h"    value="0.08"/>
  <xacro:property name="chassis_mass" value="4.0"/>

  <xacro:property name="wheel_r"    value="0.06"/>
  <xacro:property name="wheel_w"    value="0.04"/>
  <xacro:property name="wheel_mass" value="0.3"/>

  <xacro:property name="wheelbase"   value="0.28"/>
  <xacro:property name="track_width" value="0.30"/>
  <xacro:property name="steer_limit" value="0.6"/>

  <xacro:property name="chassis_z" value="${2*wheel_r + chassis_h/2}"/>

  <!-- Sensor mount macros -->
  <xacro:include filename="$(find morphonav_description)/urdf/imu.xacro"/>
  <xacro:include filename="$(find morphonav_description)/urdf/gps.xacro"/>

  <!-- Wheel and steer macros (reused for all four corners) -->
  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name="rubber"><color rgba="0.12 0.12 0.12 1.0"/></material>
      </visual>
      <visual>
        <geometry><cylinder radius="${wheel_r*0.50}" length="${wheel_w*0.35}"/></geometry>
        <origin xyz="0 ${wheel_w*0.33} 0" rpy="${pi/2} 0 0"/>
        <material name="hub_silver"><color rgba="0.78 0.78 0.78 1.0"/></material>
      </visual>
      <visual>
        <geometry><cylinder radius="${wheel_r*0.50}" length="${wheel_w*0.35}"/></geometry>
        <origin xyz="0 ${-wheel_w*0.33} 0" rpy="${pi/2} 0 0"/>
        <material name="hub_silver2"><color rgba="0.78 0.78 0.78 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass*(3*wheel_r*wheel_r + wheel_w*wheel_w)/12}"
          iyy="${wheel_mass*wheel_r*wheel_r/2}"
          izz="${wheel_mass*(3*wheel_r*wheel_r + wheel_w*wheel_w)/12}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="steer_link" params="name">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="0.013" length="${wheel_r}"/></geometry>
        <origin xyz="0 0 ${-wheel_r/2}" rpy="0 0 0"/>
        <material name="axle_silver"><color rgba="0.75 0.75 0.75 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.013" length="${wheel_r}"/></geometry>
        <origin xyz="0 0 ${-wheel_r/2}" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00002" iyy="0.00002" izz="0.00002" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Base frames -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry>
      <material name="chassis_body"><color rgba="0.17 0.17 0.20 1.0"/></material>
    </visual>
    <visual>
      <geometry><box size="${chassis_l*0.68} ${chassis_w*0.82} 0.046"/></geometry>
      <origin xyz="-0.02 0 ${chassis_h/2 + 0.023}" rpy="0 0 0"/>
      <material name="accent"><color rgba="1.0 0.44 0.0 1.0"/></material>
    </visual>
    <visual>
      <geometry><box size="0.024 ${chassis_w + 0.022} ${chassis_h*0.80}"/></geometry>
      <origin xyz="${chassis_l/2 + 0.012} 0 0" rpy="0 0 0"/>
      <material name="bumper"><color rgba="0.52 0.52 0.52 1.0"/></material>
    </visual>
    <visual>
      <geometry><box size="0.024 ${chassis_w + 0.022} ${chassis_h*0.80}"/></geometry>
      <origin xyz="${-chassis_l/2 - 0.012} 0 0" rpy="0 0 0"/>
      <material name="bumper2"><color rgba="0.52 0.52 0.52 1.0"/></material>
    </visual>
    <visual>
      <geometry><cylinder radius="0.022" length="0.06"/></geometry>
      <origin xyz="0.05 0 ${chassis_h/2 + 0.03}" rpy="0 0 0"/>
      <material name="pedestal"><color rgba="0.20 0.20 0.20 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${chassis_l + 0.05} ${chassis_w + 0.022} ${chassis_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${chassis_mass*(chassis_w*chassis_w + chassis_h*chassis_h)/12}"
        iyy="${chassis_mass*(chassis_l*chassis_l + chassis_h*chassis_h)/12}"
        izz="${chassis_mass*(chassis_l*chassis_l + chassis_w*chassis_w)/12}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Front left -->
  <joint name="front_left_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child  link="front_left_steer"/>
    <origin xyz="${wheelbase/2} ${track_width/2} ${-chassis_h/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-steer_limit}" upper="${steer_limit}" effort="10.0" velocity="2.0"/>
  </joint>
  <xacro:steer_link name="front_left_steer"/>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer"/>
    <child  link="front_left_wheel"/>
    <origin xyz="0 0 ${-wheel_r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <xacro:wheel_link name="front_left_wheel"/>

  <!-- Front right -->
  <joint name="front_right_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child  link="front_right_steer"/>
    <origin xyz="${wheelbase/2} ${-track_width/2} ${-chassis_h/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-steer_limit}" upper="${steer_limit}" effort="10.0" velocity="2.0"/>
  </joint>
  <xacro:steer_link name="front_right_steer"/>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer"/>
    <child  link="front_right_wheel"/>
    <origin xyz="0 0 ${-wheel_r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <xacro:wheel_link name="front_right_wheel"/>

  <!-- Rear left -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="rear_left_wheel"/>
    <origin xyz="${-wheelbase/2} ${track_width/2} ${-chassis_h/2 - wheel_r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <xacro:wheel_link name="rear_left_wheel"/>

  <!-- Rear right -->
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="rear_right_wheel"/>
    <origin xyz="${-wheelbase/2} ${-track_width/2} ${-chassis_h/2 - wheel_r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <xacro:wheel_link name="rear_right_wheel"/>

  <!-- Lidar -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_frame"/>
    <origin xyz="0.05 0 ${chassis_h/2 + 0.046 + 0.06 + 0.028}" rpy="0 0 0"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="0.038" length="0.055"/></geometry>
      <material name="lidar_body"><color rgba="0.04 0.04 0.04 1.0"/></material>
    </visual>
    <visual>
      <geometry><cylinder radius="0.040" length="0.010"/></geometry>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <material name="lidar_ring"><color rgba="0.15 0.55 1.0 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.038" length="0.055"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- IMU + GPS mounts -->
  <xacro:morphonav_imu parent="base_link" use_sim="${use_sim}"/>
  <xacro:morphonav_gps parent="base_link" use_sim="${use_sim}"/>

  <!-- ═══════════════════════════════════════════════
       GAZEBO — only emitted when use_sim:=true
       ═══════════════════════════════════════════════ -->
  <xacro:if value="${use_sim}">

    <!-- Wheel friction & appearance -->
    <gazebo reference="rear_left_wheel">
      <material>Gazebo/FlatBlack</material>
      <mu1>1.2</mu1><mu2>0.9</mu2>
      <kp>1000000.0</kp><kd>1.0</kd>
    </gazebo>
    <gazebo reference="rear_right_wheel">
      <material>Gazebo/FlatBlack</material>
      <mu1>1.2</mu1><mu2>0.9</mu2>
      <kp>1000000.0</kp><kd>1.0</kd>
    </gazebo>
    <gazebo reference="front_left_wheel">
      <material>Gazebo/FlatBlack</material>
      <mu1>0.8</mu1><mu2>0.6</mu2>
    </gazebo>
    <gazebo reference="front_right_wheel">
      <material>Gazebo/FlatBlack</material>
      <mu1>0.8</mu1><mu2>0.6</mu2>
    </gazebo>
    <gazebo reference="base_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- Lidar -->
    <gazebo reference="laser_frame">
      <sensor type="ray" name="rplidar_sim">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.20</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=/scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>laser_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Ackermann drive plugin (replaces the previous diff_drive plugin) -->
    <gazebo>
      <plugin name="ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
        <update_rate>50.0</update_rate>

        <front_left_joint>front_left_wheel_joint</front_left_joint>
        <front_right_joint>front_right_wheel_joint</front_right_joint>
        <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
        <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
        <left_steering_joint>front_left_steer_joint</left_steering_joint>
        <right_steering_joint>front_right_steer_joint</right_steering_joint>

        <max_steer>${steer_limit}</max_steer>
        <max_steering_angle>${steer_limit}</max_steering_angle>
        <max_speed>2.0</max_speed>

        <left_steering_pid_gain>1500 0 1</left_steering_pid_gain>
        <left_steering_i_range>0 0</left_steering_i_range>
        <right_steering_pid_gain>1500 0 1</right_steering_pid_gain>
        <right_steering_i_range>0 0</right_steering_i_range>
        <linear_velocity_pid_gain>1000 0 1</linear_velocity_pid_gain>
        <linear_velocity_i_range>0 0</linear_velocity_i_range>

        <wheel_separation>${track_width}</wheel_separation>
        <kingpin_width>${track_width}</kingpin_width>
        <wheel_base>${wheelbase}</wheel_base>
        <wheel_radius>${wheel_r}</wheel_radius>
        <wheel_diameter>${wheel_r*2}</wheel_diameter>

        <robot_base_frame>base_footprint</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        <publish_distance>false</publish_distance>

        <odometry_topic>odom</odometry_topic>
        <odometry_frame>odom</odometry_frame>
      </plugin>
    </gazebo>

    <!-- Joint state publisher so RViz/RSP gets all six non-fixed joints -->
    <gazebo>
      <plugin name="joint_state_publisher"
              filename="libgazebo_ros_joint_state_publisher.so">
        <update_rate>30</update_rate>
        <joint_name>rear_left_wheel_joint</joint_name>
        <joint_name>rear_right_wheel_joint</joint_name>
        <joint_name>front_left_steer_joint</joint_name>
        <joint_name>front_right_steer_joint</joint_name>
        <joint_name>front_left_wheel_joint</joint_name>
        <joint_name>front_right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

  </xacro:if>

</robot>
