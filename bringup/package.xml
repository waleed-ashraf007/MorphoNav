<?xml version="1.0"?>
<package format="3">
  <name>morphonav_bringup</name>
  <version>0.0.1</version>
  <description>MorphoNav top-level launch composition. Includes sensor_test (P1 smoke test) and the eventual mode-exclusive bringup launches (slam, localization, amcl, gps_outdoor, navigation).</description>
  <maintainer email="w.ashraf2002@gmail.com">Waleed Ashraf</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_imu_plugin</exec_depend>
  <exec_depend>micro_ros_agent</exec_depend>
  <exec_depend>morphonav_description</exec_depend>
  <exec_depend>morphonav_imu</exec_depend>
  <exec_depend>morphonav_gps</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>lidar_slam</exec_depend>

  <!-- SLAM + lidar -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>

  <!-- Nav2 stack -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_common</exec_depend>

  <!-- Python runtime deps for go_to_goal.py -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
